# ──────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copiá este archivo como .env y completá con los
# valores reales de tu proyecto.
# NUNCA commitees .env ni .env.local al repositorio.
# ──────────────────────────────────────────────

# ── Firebase (cliente) ──────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── API Base URL ─────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://proyecto-m4-rociocabral.vercel.app
VITE_API_BASE_URL=http://localhost:3000

# ── AWS SES (Vercel Serverless Function) ─────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2
AWS_SES_FROM_EMAIL=your_verified_email@domain.com